#version 460 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0) uniform sampler2D CurrentFrame;
layout(binding = 1) uniform sampler2D PreviousFrame;
layout(binding = 2) uniform sampler2D MotionVectors;
layout(binding = 3) uniform writeonly image2D OutGeneratedFrame;

layout(push_constant) uniform PushConstants {
    vec2 inv_render_size;
    vec2 render_size;
    float blend_factor; // timestamp between 0.0 and 1.0
    float flow_scale;
};

// Mean absolute RGB difference under which a pixel counts as unchanged between the frames.
const float STATIC_THRESHOLD = 0.012;

float ColorDistance(vec4 a, vec4 b) {
    return dot(abs(a.rgb - b.rgb), vec3(1.0 / 3.0));
}

// ── Optimized 3×3 motion vector median using textureGather ──────────
// textureGather fetches a 2×2 quad per call, so we only need 4 calls
// to cover a 3×3 neighbourhood (vs 9 individual texture() calls).
// We extract the median of X and Y components independently.
void insertionSort5(inout float a[5]) {
    for (int i = 1; i < 5; i++) {
        float key = a[i];
        int j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = key;
    }
}

vec2 sampleMotionMedian(vec2 uv) {
    vec2 texel = 1.0 / vec2(textureSize(MotionVectors, 0));

    // textureGather returns 2×2 quads: (x-0.5, y-0.5) to (x+0.5, y+0.5)
    // We use 4 gathers offset to cover the 3×3 region
    // Gather component 0 = R (motion X), component 1 = G (motion Y)
    vec4 gx0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 0); // TL quad
    vec4 gx1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 0); // TR quad
    vec4 gx2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 0); // BL quad
    vec4 gx3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 0); // BR quad

    vec4 gy0 = textureGather(MotionVectors, uv + vec2(-0.5, -0.5) * texel, 1);
    vec4 gy1 = textureGather(MotionVectors, uv + vec2( 0.5, -0.5) * texel, 1);
    vec4 gy2 = textureGather(MotionVectors, uv + vec2(-0.5,  0.5) * texel, 1);
    vec4 gy3 = textureGather(MotionVectors, uv + vec2( 0.5,  0.5) * texel, 1);

    // Extract 9 unique samples from overlapping 2×2 quads
    // gatherN.w=TL, .z=TR, .x=BL, .y=BR of each quad
    // 3×3 grid: row0=[gx0.w, gx0.z/gx1.w, gx1.z]
    //           row1=[gx0.x/gx2.w, center, gx1.y/gx3.z]
    //           row2=[gx2.x, gx2.y/gx3.x, gx3.y]
    float xs[9] = float[](gx0.w, gx1.w, gx1.z, gx0.x, texture(MotionVectors, uv).x, gx1.y, gx2.x, gx3.x, gx3.y);
    float ys[9] = float[](gy0.w, gy1.w, gy1.z, gy0.x, texture(MotionVectors, uv).y, gy1.y, gy2.x, gy3.x, gy3.y);

    // Partial sort: only need to find element [4] (median)
    // Use two passes of 5-element insertion sort on the lower half
    float xlo[5] = float[](xs[0], xs[1], xs[2], xs[3], xs[4]);
    float ylo[5] = float[](ys[0], ys[1], ys[2], ys[3], ys[4]);
    insertionSort5(xlo);
    insertionSort5(ylo);

    // Insert remaining 4 elements, keeping only the 5 smallest
    for (int i = 5; i < 9; i++) {
        if (xs[i] < xlo[4]) { xlo[4] = xs[i]; insertionSort5(xlo); }
        if (ys[i] < ylo[4]) { ylo[4] = ys[i]; insertionSort5(ylo); }
    }

    return vec2(xlo[4], ylo[4]);
}

void main() {
    ivec2 pixel_coord = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coord.x >= int(render_size.x) || pixel_coord.y >= int(render_size.y)) {
        return;
    }

    vec2 uv = (vec2(pixel_coord) + 0.5) * inv_render_size;

    // Median-filtered motion vector (reduces outlier jitter)
    vec2 motion = sampleMotionMedian(uv) / vec2(textureSize(MotionVectors, 0));

    // Pixels that didn't change (the HUD, or what the camera follows) stay in place instead of
    // warping with the motion around them.
    const vec4 previous_here = texture(PreviousFrame, uv);
    const vec4 current_here = texture(CurrentFrame, uv);
    if (ColorDistance(previous_here, current_here) < STATIC_THRESHOLD) {
        imageStore(OutGeneratedFrame, pixel_coord, mix(previous_here, current_here, blend_factor));
        return;
    }

    const vec2 forward_unclamped = uv + motion * blend_factor;
    const vec2 backward_unclamped = uv - motion * (1.0 - blend_factor);
    const vec2 forward_uv = clamp(forward_unclamped, 0.0, 1.0);
    const vec2 backward_uv = clamp(backward_unclamped, 0.0, 1.0);
    const vec4 forward_color = texture(PreviousFrame, forward_uv);
    const vec4 backward_color = texture(CurrentFrame, backward_uv);

    // A sample is unusable off screen (content entering or leaving exists in one frame only) or,
    // for a moving pixel, on static content seen through the motion. Use the other one then.
    bool forward_valid = forward_unclamped == forward_uv;
    bool backward_valid = backward_unclamped == backward_uv;
    if (length(motion * render_size) > 1.0) {
        forward_valid = forward_valid &&
                        ColorDistance(forward_color, texture(CurrentFrame, forward_uv)) >=
                            STATIC_THRESHOLD;
        backward_valid = backward_valid &&
                         ColorDistance(texture(PreviousFrame, backward_uv), backward_color) >=
                             STATIC_THRESHOLD;
    }

    vec4 interpolated;
    if (forward_valid != backward_valid) {
        interpolated = forward_valid ? forward_color : backward_color;
    } else {
        // Where the two warped samples disagree, the motion doesn't describe this pixel (an
        // animation frame changed, or something was uncovered). Blending them ghosts both
        // versions, so show the nearer real frame there instead.
        interpolated = mix(forward_color, backward_color, blend_factor);
        const vec4 nearest = blend_factor < 0.5 ? previous_here : current_here;
        interpolated = mix(interpolated, nearest,
                           smoothstep(0.04, 0.12, ColorDistance(forward_color, backward_color)));
    }

    imageStore(OutGeneratedFrame, pixel_coord, interpolated);
}
